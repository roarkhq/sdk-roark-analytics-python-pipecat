# ---------------------------------------------------------------------------
# Roark — required by RoarkObserver itself
# ---------------------------------------------------------------------------

# Roark API key — create one on the API keys page in your Roark project.
ROARK_API_KEY=rk_live_replace_me

# Pipecat webhook endpoint (call-started / call-ended events).
ROARK_WEBHOOK_URL=https://your-webhook-url.example.com/

# Chunk upload-URL endpoint (one presigned S3 PUT URL per audio chunk).
ROARK_CHUNK_UPLOAD_URL_ENDPOINT=https://your-chunk-upload-endpoint.example.com/

# ---------------------------------------------------------------------------
# Services — only needed to run examples/bot.py (not by the library itself).
# Swap providers freely in your own pipeline; RoarkObserver is provider-agnostic.
# ---------------------------------------------------------------------------

DEEPGRAM_API_KEY=
OPENAI_API_KEY=
CARTESIA_API_KEY=
